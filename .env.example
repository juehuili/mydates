# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Add http://localhost:3000 and your Vercel production URL as Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Set this to the production Vercel URL, without a trailing slash.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
